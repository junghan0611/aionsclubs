#!/usr/bin/env bash
# Verify the /eval/ receipts still describe what the house actually serves.
#
# A source-first page is only honest while its receipts match its bytes, and
# nothing here regenerates them — so this check is the thing that keeps the
# claim true.
#
# The line above used to read "Run it before publish." Nothing enforced it:
# `scripts/publish` never invoked this file, so across the 6 publishes that
# followed this script's own first release (02666b5, 2026-09-12 07:33) the only
# thing keeping a false claim off the live site was that I remembered. Measured
# 2026-09-12 in a scratch repo: one wrong data-expected, verify-eval exit 1 in
# 0.47s, publish exit 0 with the false claim landed in current/.
# A prose instruction is not a gate. `publish` now runs this against the staged
# release, which is why the root is an argument: the bytes to check are the ones
# about to be served, not whatever happens to sit in the working tree.
#
#   verify-eval [ROOT]   default ROOT = the repo this script lives in
#
#   exit 0  receipts match
#   exit 1  a receipt drifted (message names which)
set -euo pipefail

if [[ $# -gt 0 ]]; then
	ROOT="$(cd "$1" && pwd)"
else
	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi
cd "$ROOT"
fails=0
fail() { echo "eval verification failed: $*" >&2; fails=$((fails + 1)); }

# every page that loads the pinned runtime is an eval-bearing page and is held
# to the same receipts — the room, the bricks, and the brick template alike.
# "Every piece of writing in this house carries eval" (GLG, 2026-09-12) means
# this list is discovered, never hand-maintained.
mapfile -t PAGES < <(grep -rl 'src="/eval/runtime/' --include='*.html' . | sed 's|^\./||' | sort)
if [[ ${#PAGES[@]} -eq 0 ]]; then
	fail "no page loads the pinned runtime — the house has stopped carrying eval"
fi

# 1. every runtime file is pinned by its own full sha256 in the filename
shopt -s nullglob
runtimes=(eval/runtime/*.js)
if [[ ${#runtimes[@]} -eq 0 ]]; then
	fail "no runtime bundle found under eval/runtime/"
fi
for f in "${runtimes[@]}"; do
	have=$(sha256sum "$f" | cut -d' ' -f1)
	case "$(basename "$f")" in
		*"$have"*) ;;
		*) fail "filename does not pin its content hash: $f (sha256 $have)" ;;
	esac
done

# 2. the evaluator hash recorded in manifest + sbom is the evaluator we serve
for js in eval/eval.js eval/inline.js; do
	h=$(sha256sum "$js" | cut -d' ' -f1)
	for receipt in eval/runtime/manifest.json eval/runtime/sbom.json; do
		grep -q "$h" "$receipt" || fail "$receipt does not record $js sha256 $h"
	done
	grep -q "$(basename "$js")" javascript/index.html \
		|| fail "/javascript/ does not list $js"
done

# 3. every script the page loads exists, and the only off-site origin is the
#    one disclosed in /javascript/ (GLG's self-hosted Umami beacon). Any other
#    remote script means the page's audit claim has quietly stopped being true.
allowed_remote="https://analytics.junghanacs.com/script.js"
for page in "${PAGES[@]}"; do
	while IFS= read -r src; do
		case "$src" in
			"$allowed_remote")
				grep -q "analytics.junghanacs.com" javascript/index.html \
					|| fail "the analytics beacon is loaded but not disclosed in /javascript/" ;;
			http*) fail "$page loads an undisclosed off-site script: $src" ;;
			/*) [[ -f ".${src}" ]] || fail "$page loads a missing script: $src" ;;
		esac
	done < <(grep -o 'src="[^"]*"' "$page" | sed 's/^src="//; s/"$//')
done

# 4. the runtime the page loads is the one the receipts describe
for page in "${PAGES[@]}"; do
	while IFS= read -r src; do
		grep -q "$(basename "$src")" eval/runtime/manifest.json \
			|| fail "$page loads $src but the manifest does not list it"
	done < <(grep -o 'src="/eval/[^"]*"' "$page" | sed 's/^src="//; s/"$//')
done

# 5. license files referenced by the receipts and pages are actually present
while IFS= read -r lic; do
	[[ -f ".${lic}" ]] || fail "missing license file: $lic"
done < <(grep -ho '/eval/licenses/[A-Za-z0-9.-]*\.txt' "${PAGES[@]}" javascript/index.html eval/runtime/*.json | sort -u)

# 6. each cell that asserts a value still has a source to assert it against
cells=0; expects=0; outs=0
for page in "${PAGES[@]}"; do
	c=$(grep -c 'class="eval-cell"' "$page" || true)
	t=$(grep -c '<textarea' "$page" || true)
	o=$(grep -c '<output[^>]*data-eval=' "$page" || true)
	[[ "$c" -eq "$t" ]] || fail "$page: cell/textarea mismatch — $c cells, $t sources"
	# an in-sentence claim must keep the author's text as its fallback, or the
	# sentence loses its number when JavaScript is off
	empty=$(grep -c '<output[^>]*data-eval="[^"]*"[^>]*></output>' "$page" || true)
	[[ "$empty" -eq 0 ]] || fail "$page: $empty empty <output data-eval> — the claim would vanish without JavaScript"
	cells=$((cells + c)); outs=$((outs + o))
	expects=$((expects + $(grep -c 'data-expected=' "$page" || true)))
done
[[ $((cells + outs)) -ge 1 ]] || fail "no page carries a cell or an in-sentence claim"
[[ "$expects" -ge 1 ]] || fail "nothing carries data-expected — nothing would fail visibly"

# 7. the cells actually evaluate: load the real bundle and the real evaluator,
#    drive them with this page's own cells, and require a wrong assertion to
#    fail. A cell that cannot go ERROR is decoration.
if command -v node >/dev/null 2>&1; then
	node scripts/verify-eval-cells.mjs "${PAGES[@]}" || fail "published cells did not all pass (see output above)"
else
	echo "note: node not found — skipped the cell evaluation probe" >&2
fi

# 8. the adopted engine module is the one the shelf published, and it still
#    satisfies the shelf's conformance fixture. `eval/engine/README.md` claimed
#    this file re-checked that "on every publish"; measured 2026-09-13, this
#    script did not mention eval/engine/ at all. The hash lived in a filename,
#    and a filename survives any edit to the bytes it names — so swapped bytes
#    would have redefined what every assertion in the house means with all 33
#    claims still reporting PASS. The prose is now a gate.
if command -v node >/dev/null 2>&1; then
	node scripts/verify-engine.mjs || fail "adopted engine module drifted (see output above)"

	# 8a. and the shelf's own answer, on the road rather than in prose. Until now
	#     `--online` existed only as an instruction in two READMEs — the same defect
	#     this house published three bricks about, written a fifth time, by me, in
	#     the hour I spent teaching that flag the discovery feed's arrival.
	#     It was kept off the road because "a house whose deploy dies when the
	#     network dies is a worse house". That reason survives here without the
	#     exclusion, because the script already separates the two answers:
	#       exit 3  could not reach the shelf  → say so, publish anyway
	#       exit 1  the shelf disagrees with us → that is drift, and it blocks
	#     Set ENGINE_OFFLINE=1 to skip the network entirely.
	if [[ -z "${ENGINE_OFFLINE:-}" ]]; then
		# `set -e` is on: a bare assignment from a failing substitution would abort
		# the script before the case could read the status, so capture it explicitly
		online_rc=0
		online_out=$(node scripts/verify-engine.mjs --online 2>&1) || online_rc=$?
		case "$online_rc" in
			# `engine news:` is the channel for an upstream change that a person should
			# read but that must not stop a publish — it has to reach stderr on the
			# success path or it is a finding nobody sees
			0) echo "$online_out" | grep -E '^engine (note: (http|feed|shelf)|news:)' >&2 || true ;;
			3) echo "note: could not reach the engine shelf — published without asking it (offline checks passed)" >&2 ;;
			*) echo "$online_out" >&2; fail "the engine shelf disagrees with this house (see output above)" ;;
		esac
	else
		echo "note: ENGINE_OFFLINE set — did not ask the shelf what it publishes now" >&2
	fi
else
	echo "note: node not found — skipped the adopted-engine check" >&2
fi

if [[ "$fails" -gt 0 ]]; then
	echo "eval: $fails problem(s)" >&2
	exit 1
fi
echo "eval ok: ${#runtimes[@]} pinned runtime file(s) · ${#PAGES[@]} eval-bearing page(s) · $cells cell(s) · $outs in-sentence claim(s) · $expects asserted · no undisclosed remote scripts"
