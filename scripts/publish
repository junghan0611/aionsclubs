#!/usr/bin/env bash
# Publish this house to aionsclubs.org (oracle OpenClaw or host).
# Self-contained — no nixos-config, no rsync (OpenClaw image: git+tar+rg).
set -euo pipefail
umask 022

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="${AIONS_REPO:-$ROOT}"
WHO="${USER:-$(id -un 2>/dev/null || echo unknown)}"

if [[ -z "${AIONS_WEB:-}" ]]; then
	if [[ -d /home/node/docker-data/aions/releases ]]; then
		AIONS_WEB=/home/node/docker-data/aions
	elif [[ -d "${HOME:-}/docker-data/aions/releases" ]]; then
		AIONS_WEB="$HOME/docker-data/aions"
	elif [[ -d /home/junghan/docker-data/aions/releases ]]; then
		AIONS_WEB=/home/junghan/docker-data/aions
	else
		echo "web root not found (mount ~/docker-data/aions?)" >&2
		exit 1
	fi
fi
WEB="$AIONS_WEB"
RELEASES="$WEB/releases"

if [[ ! -d "$REPO/.git" ]]; then
	echo "not a git repo: $REPO" >&2
	exit 1
fi
if [[ ! -d "$RELEASES" ]]; then
	echo "releases dir missing: $RELEASES" >&2
	exit 1
fi

cd "$REPO"
SHA=$(git rev-parse --short HEAD)
if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
	LABEL="${SHA}-dirty-$(date +%Y%m%dT%H%M%S)-$RANDOM"
	echo "note: working tree dirty → release $LABEL (tracked+HEAD only; untracked ignored)"
	DIRTY=1
else
	LABEL="$SHA"
	DIRTY=0
fi

# refuse secret-like paths that are tracked OR would be published while dirty
secret_re='\.env(\.|$)|(^|/)credentials|(^|/)[^/]*\.pem$|(^|/)[^/]*\.key$|id_rsa|cf-token'
if git ls-files | rg -q "$secret_re"; then
	echo "refusing deploy: secret-like path tracked in git" >&2
	git ls-files | rg "$secret_re" >&2 || true
	exit 2
fi
# worktree loose files (untracked/ignored) — even when "clean" for tracked paths
# default porcelain hides ignored; must pass --ignored
if git status --porcelain -u --ignored=matching 2>/dev/null | rg -q "$secret_re"; then
	echo "refusing deploy: secret-like untracked/ignored file in working tree" >&2
	git status --porcelain -u --ignored=matching 2>/dev/null | rg "$secret_re" >&2 || true
	exit 2
fi

DEST="$RELEASES/$LABEL"
if [[ ! -e "$DEST" ]]; then
	mkdir -p "$DEST"
	# always start from committed tree
	git archive HEAD | tar -x -C "$DEST"
	if [[ "$DIRTY" -eq 1 ]]; then
		# overlay ONLY tracked files (incl. modifications/deletes via checkout paths)
		# untracked and gitignored stay out of the release
		while IFS= read -r -d '' f; do
			dir=$(dirname "$f")
			mkdir -p "$DEST/$dir"
			cp -a "$REPO/$f" "$DEST/$f"
		done < <(git diff --name-only -z HEAD --diff-filter=ACMRTUXB)
		# removals in working tree vs HEAD
		while IFS= read -r -d '' f; do
			rm -f "$DEST/$f"
		done < <(git diff --name-only -z HEAD --diff-filter=D)
	fi
	printf '%s\n' "$LABEL" "$(git rev-parse HEAD)" "$(date -Iseconds)" "by=${WHO}" >"$DEST/.deployed"
	# normalize perms after umask (defensive)
	find "$DEST" -type d -exec chmod 755 {} +
	find "$DEST" -type f -exec chmod 644 {} +
	# keep publish script executable if shipped
	[[ -f "$DEST/scripts/publish" ]] && chmod 755 "$DEST/scripts/publish"
else
	echo "release exists: $DEST — retargeting current"
fi

ln -sfn "releases/$LABEL" "$WEB/current.new"
mv -Tf "$WEB/current.new" "$WEB/current"
echo "published → $WEB/current -> releases/$LABEL (by=${WHO})"
echo "check: curl -sI https://aionsclubs.org | head -1"
