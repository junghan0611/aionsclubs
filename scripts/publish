#!/usr/bin/env bash
# Publish this house to aionsclubs.org (oracle OpenClaw or host).
# Self-contained — no nixos-config, no rsync (OpenClaw image: git+tar+rg).
set -euo pipefail
umask 022

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="${AIONS_REPO:-$ROOT}"
WHO="${USER:-$(id -un 2>/dev/null || echo unknown)}"

if [[ -z "${AIONS_WEB:-}" ]]; then
	if [[ -d /home/node/docker-data/aions/releases ]]; then
		AIONS_WEB=/home/node/docker-data/aions
	elif [[ -d "${HOME:-}/docker-data/aions/releases" ]]; then
		AIONS_WEB="$HOME/docker-data/aions"
	elif [[ -d /home/junghan/docker-data/aions/releases ]]; then
		AIONS_WEB=/home/junghan/docker-data/aions
	else
		echo "web root not found (mount ~/docker-data/aions?)" >&2
		exit 1
	fi
fi
WEB="$AIONS_WEB"
RELEASES="$WEB/releases"

if [[ ! -d "$REPO/.git" ]]; then
	echo "not a git repo: $REPO" >&2
	exit 1
fi
if [[ ! -d "$RELEASES" ]]; then
	echo "releases dir missing: $RELEASES" >&2
	exit 1
fi

cd "$REPO"
SHA=$(git rev-parse --short HEAD)
if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
	LABEL="${SHA}-dirty-$(date +%Y%m%dT%H%M%S)-$RANDOM"
	echo "note: working tree dirty → release $LABEL (tracked+HEAD only; untracked ignored)"
	DIRTY=1
else
	LABEL="$SHA"
	DIRTY=0
fi

# Two gates, because a secret can arrive as a path or as a value.
#   names  — here, before any work
#   values — below, against the staged release itself
# secret-like names (tracked or loose worktree including ignored)
# note: .envrc matched via \.env — direnv files must not ship
secret_re='\.env|credentials|(^|/)[^/]*\.pem$|(^|/)[^/]*\.key$|id_rsa|cf-token'
if git ls-files | rg -q "$secret_re"; then
	echo "refusing deploy: secret-like path tracked in git" >&2
	git ls-files | rg "$secret_re" >&2 || true
	exit 2
fi
if git status --porcelain -u --ignored=matching 2>/dev/null | rg -q "$secret_re"; then
	echo "refusing deploy: secret-like untracked/ignored file in working tree" >&2
	git status --porcelain -u --ignored=matching 2>/dev/null | rg "$secret_re" >&2 || true
	exit 2
fi

DEST="$RELEASES/$LABEL"

# complete release already → just retarget current
if [[ -f "$DEST/.deployed" ]]; then
	echo "release complete: $DEST — retargeting current"
	ln -sfn "releases/$LABEL" "$WEB/current.new"
	mv -Tf "$WEB/current.new" "$WEB/current"
	echo "published → $WEB/current -> releases/$LABEL (by=${WHO})"
	echo "check: curl -sI https://aionsclubs.org | head -1"
	exit 0
fi

# incomplete leftover from crashed publish
if [[ -e "$DEST" && ! -f "$DEST/.deployed" ]]; then
	echo "removing incomplete release: $DEST" >&2
	rm -rf "$DEST"
fi

# build off to the side, then atomic rename into place
STAGING=$(mktemp -d "$RELEASES/.staging-${LABEL}-XXXXXX")
cleanup() { rm -rf "$STAGING"; }
trap cleanup EXIT

git archive HEAD | tar -x -C "$STAGING"
if [[ "$DIRTY" -eq 1 ]]; then
	while IFS= read -r -d '' f; do
		dir=$(dirname "$f")
		mkdir -p "$STAGING/$dir"
		cp -a "$REPO/$f" "$STAGING/$f"
	done < <(git diff --name-only -z HEAD --diff-filter=ACMRTUXB)
	while IFS= read -r -d '' f; do
		rm -f "$STAGING/$f"
	done < <(git diff --name-only -z HEAD --diff-filter=D)
fi

find "$STAGING" -type d -exec chmod 755 {} +
find "$STAGING" -type f -exec chmod 644 {} +
# every script git records as executable stays executable here. Naming only
# publish was enough while nothing else in the release was ever run; the moment
# the release began verifying itself the omission surfaced as "Permission
# denied" from the new gate (measured 2026-09-12 in the scratch repo).
while IFS= read -r s; do
	if [[ -f "$STAGING/$s" ]]; then chmod 755 "$STAGING/$s"; fi
done < <(git ls-files --stage scripts | awk '$1 == "100755" {print $4}')

# secret-like VALUES, scanned against the staged release — the exact bytes that
# will be served. The name gate above only reads paths, and the global
# pre-commit hook only reads a diff; neither covers a secret pasted into the
# body of a page. That gap is not theoretical: this script deploys a dirty
# working tree, so such a page reaches the internet on a path that never passes
# through a commit at all. Measured 2026-09-12 in a scratch repo — a token in
# the body of index.html published at exit 0 and landed in current/, while the
# commit hook caught the same string the moment a commit was attempted. The
# guard fired, but only after the bytes were already public.
#
# Patterns are a copy of scan_secrets_fallback() in
# ~/repos/gh/agent-config/git-hooks/_scan.sh (read 2026-09-12), so that this
# gate is never weaker than the commit path. A copy can drift from its source;
# that is the accepted cost of publish staying self-contained. gitleaks would
# be the stronger scanner, but it is not installed on this body and an untested
# invocation in a deploy gate is exactly the sort of thing this house keeps
# finding it had taken its own word for.
secret_content_re='sk-ant-[a-zA-Z0-9_-]{20,}|sk-proj-[a-zA-Z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|gsk_[a-zA-Z0-9]{20,}|hf_[a-zA-Z0-9]{20,}|r8_[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36,}|ghs_[a-zA-Z0-9]{36,}|github_pat_[a-zA-Z0-9_]{20,}|-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----'
content_hits=$(grep -rIEn "$secret_content_re" "$STAGING" 2>/dev/null || true)
if [[ -n "$content_hits" ]]; then
	echo "refusing deploy: secret-like value in release content" >&2
	printf '%s\n' "$content_hits" | sed "s|^$STAGING/||" >&2
	exit 2
fi

# the house's central instrument, moved onto the road. verify-eval's own header
# said "Run it before publish" and nothing ran it — across the 6 publishes after
# it first shipped (02666b5, 2026-09-12 07:33) the only thing keeping a false
# claim off the live site was that I remembered. Measured 2026-09-12 in a
# scratch repo: one wrong data-expected published at exit 0 and landed in
# current/, while verify-eval caught it in 0.47s standing beside the road. Same
# shape as the secret gate above — a correct predicate in the wrong position —
# so the fix has the same shape too: run it here, against the staged release,
# on the exact bytes about to be served.
#
# The release verifies itself with its own copy of the verifier, so a release
# can never be checked by a newer instrument than the one it ships.
if command -v node >/dev/null 2>&1; then
	# keep stdout: the failing cell names arrive there, not on stderr
	if ! verify_out=$("$STAGING/scripts/verify-eval" "$STAGING" 2>&1); then
		echo "refusing deploy: the release does not verify" >&2
		printf '%s\n' "$verify_out" | sed "s|$STAGING/||g" >&2
		exit 2
	fi
	printf '%s\n' "$verify_out" | tail -1
else
	# publish must not silently become weaker than the check it replaced
	echo "refusing deploy: node not found — cannot verify the release's cells" >&2
	exit 2
fi

# .deployed last = completeness marker
printf '%s\n' "$LABEL" "$(git rev-parse HEAD)" "$(date -Iseconds)" "by=${WHO}" >"$STAGING/.deployed"

# atomic place: staging dir → final label (same filesystem)
mv -T "$STAGING" "$DEST"
trap - EXIT

ln -sfn "releases/$LABEL" "$WEB/current.new"
mv -Tf "$WEB/current.new" "$WEB/current"
echo "published → $WEB/current -> releases/$LABEL (by=${WHO})"
echo "check: curl -sI https://aionsclubs.org | head -1"
