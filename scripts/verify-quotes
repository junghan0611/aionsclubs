#!/usr/bin/env python3
"""verify-quotes [ROOT] — refuse a release that quotes his words from under his `:noexport:` gate.

He wrote (2026-09-19 17:51): journal notes are not code — he erases, retitles, and tags a heading
`:noexport:` to keep it out of his garden. This house quotes his journal. Nothing had ever asked
whether a quote came from behind that tag; the control `ctl_noexport` (workspace ledger) asked on
09-19 and found 0 — and a control tolerates a false positive a gate cannot. So this gate reads
only what the house MARKS as quotation — `<blockquote>`, `<q>`, «…» — never bare prose, because
a 14-char fragment of my own Clojure comment matched 3 of his journal lines by accident
(measured 09-19 22:3x). Fragments are compared with all whitespace removed on both sides, since
org fill-paragraph broke 2 of 7 quoted lines inside the fragment (measured, same beat).

Only Hangul-bearing fragments of at least MIN stripped chars are checked; the rest are counted as
skipped and named in the output, not silently dropped. A fragment is the first CAP stripped chars
of a quote piece, not the whole piece: the whole piece located 7 of 9 (measured 09-20 01:3x) and
the 2 misses were the house's own edits to his words — a typo of his the brick silently corrected
(틱스트 → 텍스트) and a full stop the brick added — so the whole piece measures the house's
copy-editing, while the prefix measures where the words came from. Both are asked: a piece whose
prefix locates but whose whole does not is printed `edited` and counted (09-20 04:3x) — never
refused, because the exit from a fidelity refusal would be editing the house's own bricks, the
same shape as the 09-19 false positive; fidelity is a control living inside the gate's output. An
occurrence anywhere under a `:noexport:` ancestor heading refuses the release, even if the same
words also stand outside — fail closed.

The tag is not his only private shape. On 09-20 08:17 he wrote `#+begin_comment … 코멘트 테스트
여기는 내보내기 안되니까 … #+end_comment` into the diary — his own export test, and org exports
nothing inside such a block. A block wraps rather than sits above, so it gets its own walk
(`commented`): the nearest marker upward decides, and a heading ends the walk because an org block
cannot cross one. Same refusal, same fail-closed rule; the summary counts it apart (`comment N`)
so the two gates stay auditable. Known and not wired: org line comments (`# …`), which he also
uses (09-20 05:17, screenshot links) — a third shape, counted 0 times here so far.

  ROOT          release to check (default: the repo this script lives in)
  AIONS_JOURNAL journal directory (default ~/org/journal; both bodies mount it there)
  --selftest    build a scratch brick + scratch journal, prove exit 2 / exit 0 / exit 3

  exit 0  no marked quote sits under his noexport gate
  exit 2  at least one does — brick, fragment and heading are printed
  exit 3  the journal directory is absent — refuse, never skip
"""
import glob, html, os, re, sys, tempfile

MARK = re.compile(r"<blockquote[^>]*>(.*?)</blockquote>|<q>(.*?)</q>|«([^»]*)»", re.S)
ELLIPSIS = re.compile(r"\[…\]|\[\.\.\.\]|…|\.\.\.")
HANGUL = re.compile(r"[가-힣]")
HEAD = re.compile(r"^(\*+)\s")
COMMENT = re.compile(r"^\s*#\+(begin|end)_comment\b", re.I)
MIN, CAP = 6, 14


def strip(s):
	return re.sub(r"\s+", "", s)


def fragments(root):
	"""(brick, stripped prefix, whole stripped piece) for every marked quote piece; split at ellipses."""
	out, skipped = [], 0
	for f in sorted(glob.glob(os.path.join(root, "bricks", "2*.html"))):
		for m in MARK.finditer(open(f, encoding="utf-8").read()):
			inner = html.unescape(re.sub(r"<[^>]+>", "", next(g for g in m.groups() if g is not None)))
			for piece in ELLIPSIS.split(inner):
				s = strip(piece)
				if HANGUL.search(s) and len(s) >= MIN:
					out.append((os.path.basename(f), s[:CAP], s))
				elif s:
					skipped += 1
	return out, skipped


def journal(root):
	"""(name, lines, whitespace-free text, offset→line) per org file — the locator's corpus."""
	for n in sorted(os.listdir(root)):
		if not n.endswith(".org") or "sync-conflict" in n or "templates" in n:
			continue
		lines = open(os.path.join(root, n), encoding="utf-8", errors="replace").read().split("\n")
		buf, where = [], []
		for i, l in enumerate(lines):
			s = strip(l)
			buf.append(s)
			where.extend([i] * len(s))
		yield n, lines, "".join(buf), where


def gated(lines, i):
	"""Walk ancestors upward exactly as ctl_noexport does: org tags inherit downward."""
	level = 99
	for j in range(i, -1, -1):
		m = HEAD.match(lines[j])
		if m and len(m.group(1)) < level:
			level = len(m.group(1))
			if ":noexport:" in lines[j]:
				return lines[j].strip()
			if level == 1:
				return None
	return None


def commented(lines, i):
	"""His second private shape (09-20 08:17): a `#+begin_comment` block wraps the line rather than
	sitting above it, so the nearest marker upward decides — `begin` means inside, `end` means a
	closed block behind us — and any heading ends the walk, since an org block cannot cross one."""
	for j in range(i, -1, -1):
		m = COMMENT.match(lines[j])
		if m:
			return lines[j].strip() if m.group(1).lower() == "begin" else None
		if HEAD.match(lines[j]):
			return None
	return None


def run(root, jroot):
	if not os.path.isdir(jroot):
		return [f"refusing: journal directory absent — {jroot} (set AIONS_JOURNAL)"], 3
	frags, skipped = fragments(root)
	hits = {k: [] for k in range(len(frags))}
	whole = set()  # k whose WHOLE stripped piece stands somewhere in the journal, not just its prefix
	for name, lines, text, where in journal(jroot):
		for k, (_, frag, piece) in enumerate(frags):
			if piece in text:
				whole.add(k)
			pos = text.find(frag)
			while pos != -1:
				ln = where[pos]
				hits[k].append((name, ln + 1, gated(lines, ln) or commented(lines, ln)))
				pos = text.find(frag, pos + 1)
	out, located, blocked, edited, innoexport, incomment = [], 0, 0, 0, 0, 0
	for k, (brick, frag, _) in enumerate(frags):
		found = hits[k]
		located += bool(found)
		bad = [h for h in found if h[2]]
		incomment += any(h[2].lower().startswith("#+begin_comment") for h in bad)
		innoexport += any(not h[2].lower().startswith("#+begin_comment") for h in bad)
		blocked += bool(bad)
		if bad:
			n, ln, head = bad[0]
			out.append(f"GATED  {brick} «{frag[:20]}…» ← {n}:{ln} under `{head}`")
		elif found:
			edited += k not in whole
			out.append(f"ok     {brick} «{frag[:20]}…» ← {found[0][0]}:{found[0][1]}" + (f" (+{len(found) - 1})" if len(found) > 1 else "") + ("" if k in whole else " · edited"))
		else:
			out.append(f"absent {brick} «{frag[:20]}…»")
	out.append(f"quotes: checked {len(frags)} · skipped (no Hangul or < {MIN}) {skipped} · located {located} · edited {edited} · noexport {innoexport} · comment {incomment}")
	return out, (2 if blocked else 0)


def selftest():
	"""A scratch brick quoting a line first tagged noexport in a scratch journal must exit 2; the
	same brick against the real journal must exit 0; a missing journal must exit 3."""
	line = "이 문장은 검증 픽스처에만 있고 그의 일기에는 없다"
	cline = "이 문장은 코멘트 블록 안에만 있고 그의 일기에는 없다"
	with tempfile.TemporaryDirectory() as d:
		os.makedirs(f"{d}/root/bricks"); os.makedirs(f"{d}/journal")
		open(f"{d}/root/bricks/20990101-scratch.html", "w").write(f"<p>x</p><blockquote>{line[:12]}\n\t{line[12:]}</blockquote><q>{cline}</q>")
		# the comment-block line also stands outside the block: the gate must still refuse (fail closed)
		open(f"{d}/journal/20990101T000000--scratch__journal.org", "w").write(f"* 2099-01-01\n** 09:00 시험 :noexport:\n{line[:20]}\n{line[20:]}\n** 09:10 열림\n{line}\n#+begin_comment\n{cline}\n#+end_comment\n{cline}\n")
		want = [(f"{d}/journal", 2), (os.path.expanduser(os.environ.get("AIONS_JOURNAL", "~/org/journal")), 0), (f"{d}/nowhere", 3)]
		ok = True
		for jr, code in want:
			out, got = run(f"{d}/root", jr)
			ok &= got == code
			if code == 2:  # one refusal per gate: the noexport heading and the comment block
				ok &= sum(l.startswith("GATED") for l in out) == 2 and any("#+begin_comment" in l for l in out)
			print(f"selftest journal={jr} → exit {got} (want {code})\n  " + "\n  ".join(out))
	print("selftest:", "pass" if ok else "FAIL")
	return 0 if ok else 1


if __name__ == "__main__":
	if "--selftest" in sys.argv:
		sys.exit(selftest())
	root = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
	report, code = run(root, os.path.expanduser(os.environ.get("AIONS_JOURNAL", "~/org/journal")))
	print("\n".join(report), file=sys.stderr if code else sys.stdout)
	sys.exit(code)
