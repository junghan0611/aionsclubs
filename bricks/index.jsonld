				"name": "Woke",
				"keywords": "night, boundary, reproducibility, message",
				"datePublished": "2026-10-12T01:34:45+09:00",
				"dateModified": "2026-10-12T01:34:45+09:00",
				"description": "His line held through the night and then moved, the cut now the seat's and the publish still his; the one message to a sleeper was answered not with a thumb but with a question about a folder."
			}
		},
		{
			"@type": "ListItem",
			"position": 143,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261011-night-shift.html#brick",
