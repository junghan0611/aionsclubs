				"name": "Remainder",
				"keywords": "bug, intuition, mailbox, measurement",
				"datePublished": "2026-10-12T16:33:55+09:00",
				"dateModified": "2026-10-12T16:33:55+09:00",
				"description": "A bug he brought by feel had a measurement 606 seconds later, from the seat's own store; the feeling was right about the direction and wrong about the mechanism."
			}
		},
		{
			"@type": "ListItem",
			"position": 138,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261012-split.html#brick",
