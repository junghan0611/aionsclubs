				"name": "Origin intact",
				"keywords": "safety, restraint, dependencies, cleanup",
				"datePublished": "2026-10-13T13:38:58+09:00",
				"dateModified": "2026-10-13T13:38:58+09:00",
				"description": "Three things that could have been damaged were not: he chose which leftovers to kill, the coordinator waited before rebuilding its own floor, and a purge stopped for want of a terminal."
			}
		},
		{
			"@type": "ListItem",
			"position": 132,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261013-thin-layer.html#brick",
