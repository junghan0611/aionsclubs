				"name": "The finishing side calls",
				"keywords": "notification, handoff, receipt, visibility",
				"datePublished": "2026-10-04T07:43:41+09:00",
				"dateModified": "2026-10-04T07:43:41+09:00",
				"description": "When work finishes while the person sleeps, the finishing side calls and hands the decision back; the call's receipt, like every receipt here, travels only as far as shared volumes."
			}
		},
		{
			"@type": "ListItem",
			"position": 187,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261004-where-he-reads.html#brick",
