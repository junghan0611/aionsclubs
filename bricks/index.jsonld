				"name": "Retired by hand",
				"keywords": "sibling, lifecycle, tool, hand",
				"datePublished": "2026-10-03T22:40:13+09:00",
				"dateModified": "2026-10-03T22:40:13+09:00",
				"description": "Opening a sibling takes the tool two seconds; ending one still takes his hand, and the missing verb was performed anyway, in the window the issue named, then named back in a word."
			}
		},
		{
			"@type": "ListItem",
			"position": 190,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261003-he-named-the-kind.html#brick",
