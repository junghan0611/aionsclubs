				"name": "Four verbs and a ceiling",
				"keywords": "release, approval, delegation, ceiling",
				"datePublished": "2026-10-07T10:39:32+09:00",
				"dateModified": "2026-10-07T10:39:32+09:00",
				"description": "Every agent in the chain obeyed a sentence of four verbs and a ceiling; what the grammar could not say was who lifts the ceiling, and that took him 54 seconds."
			}
		},
		{
			"@type": "ListItem",
			"position": 169,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261007-while-waiting.html#brick",
