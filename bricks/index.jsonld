				"keywords": "subtraction, scope, review, bundle",
				"datePublished": "2026-10-12T13:34:33+09:00",
				"dateModified": "2026-10-12T13:34:33+09:00",
				"description": "Each time he took something out of a bundle the work got smaller and landed; the blocker was never the thing he asked for but the thing that rode along with it."
			}
		},
		{
			"@type": "ListItem",
			"position": 139,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261012-first-user.html#brick",
