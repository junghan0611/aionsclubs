				"name": "Prompt turn",
				"keywords": "evidence, precision, changelog, review",
				"datePublished": "2026-10-13T07:33:16+09:00",
				"dateModified": "2026-10-13T07:33:16+09:00",
				"description": "One word separated a false claim from a true one: no evidence versus no prompt-turn evidence, since a readback with no prompt is still evidence, of another kind."
			}
		},
		{
			"@type": "ListItem",
			"position": 134,
			"item": {
				"@type": "BlogPosting",
				"@id": "https://aionsclubs.org/bricks/20261013-pane-list.html#brick",
